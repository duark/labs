# Copie para .env para testar o formulário localmente.
# Chave da API do Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# E-mail que recebe as mensagens do formulário
CONTACT_TO=voce@seudominio.com
# Remetente (precisa ser de um domínio verificado no Resend).
# Sem domínio verificado, use onboarding@resend.dev (só envia para o e-mail da sua conta Resend).
CONTACT_FROM=Portfólio <onboarding@resend.dev>
# Opcional: URL pública do site. Na Vercel é detectada automaticamente.
# SITE_URL=https://seudominio.com
